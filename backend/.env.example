NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=0

# PostgreSQL connection string. For Neon, include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_MAX=10

# Generate a unique value with at least 32 bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

# Optional: required only for AI features. Keep this key in the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FORMAT_MODEL=gemini-3.5-flash-lite

EDUFLOW_DEMO_MODE=false

# Set these only when running `npm run bootstrap:admin`, then remove the password.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
